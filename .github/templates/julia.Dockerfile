# Auto-generated by .github/scripts/update-julia.sh (Julia version from
# Project.toml [compat]); pinned by the committed Manifest.toml. Do not edit.
FROM julia:@JULIA_VERSION@

ENV JULIA_PROJECT=/opt/@UNIT@
ENV JULIA_DEPOT_PATH=/usr/local/share/.julia
ENV JULIA_HISTORY=/tmp/logs/repl_history.jl

# procps: `ps` is needed by Nextflow reports
RUN apt-get update \
    && apt-get install -y procps \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/@UNIT@ /usr/local/share/.julia /tmp/logs \
    && chmod 0755 /opt/@UNIT@ /usr/local/share/.julia /tmp/logs

COPY Project.toml Manifest.toml /opt/@UNIT@/
RUN julia -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'
