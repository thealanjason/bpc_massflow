// main.nf declares each unit's *intent* (a conda `environment.yml`, or a `container`
// for image-native units like lhs). The wiring that turns that intent into a
// reproducible install lives here, driven by params:
//   default              -> conda, installed from the committed platform lock file
//   --useLockFiles false -> conda, solving environment.yml at runtime
//   --containerized      -> ignore conda, run every unit from its pushed image
// (Helpers are params-held closures: Nextflow's config parser forbids top-level
//  method definitions.)

params {
    // Conda environment resolution.
    // useLockFiles: true -> install from the committed per-platform lock files under
    //   <unit>/lockfile/ (reproducible, no solve). false -> solve <unit>/environment.yml.
    // lockPlatform: which committed lock to use; auto-detected from the host,
    //   override with --lockPlatform (linux-64|linux-aarch64|osx-64|osx-arm64|win-64).
    // condaEngine: micromamba by default (or conda, mamba).
    useLockFiles = true
    lockPlatform = {
        def os   = System.getProperty('os.name').toLowerCase()
        def arch = System.getProperty('os.arch').toLowerCase()
        def arm  = arch in ['aarch64', 'arm64']
        (os.contains('mac') || os.contains('darwin')) ? (arm ? 'osx-arm64' : 'osx-64')
            : os.contains('windows')                  ? 'win-64'
            : (arm ? 'linux-aarch64' : 'linux-64')
    }()
    condaEngine = 'micromamba'

    // Containerized execution: run every unit from its pushed GHCR image instead
    // of conda. Enable with --containerized. Units without a lock for the platform
    // (e.g. mcmc, which has pip deps) are only reproducible this way.
    containerized = false
    imageRepo     = 'ghcr.io/thealanjason/bpc_massflow'
    imageTag      = 'latest'

    // Internal resolvers (see the withName overrides below). Take a unit name.
    // conda spec: platform lock when it exists (and requested), else environment.yml;
    // null under --containerized so conda is left unset.
    condaFor = { unit ->
        if (params.containerized) return null
        def envYml = "${projectDir}/${unit}/environment.yml"
        if (!params.useLockFiles) return envYml
        def lock = "${projectDir}/${unit}/lockfile/conda-${params.lockPlatform}.lock"
        new File(lock as String).exists() ? lock : envYml
    }
    // GHCR image under --containerized, else null so container is left unset.
    containerFor = { unit ->
        params.containerized ? "${params.imageRepo}/${unit}:${params.imageTag}" : null
    }
}

process {
    // Per-unit env resolution. Each closure returns a value or null; a null directive
    // is left unset, so a unit runs via conda XOR its container.
    // lhs (LHS) is image-native: its container stays in main.nf.
    withName: FORWARD_MODEL                  { conda = { params.condaFor('forward_model') }; container = { params.containerFor('forward_model') } }
    withName: 'TRAIN_SURROGATE|SERVE_SURROGATE' { conda = { params.condaFor('surrogate') };     container = { params.containerFor('surrogate') } }
    withName: MCMC                           { conda = { params.condaFor('mcmc') };          container = { params.containerFor('mcmc') } }
}

// Conda is off under --containerized (every unit runs from its image instead).
conda.enabled       = !params.containerized
conda.useMamba      = params.condaEngine == 'mamba'
conda.useMicromamba = params.condaEngine == 'micromamba'

// Container engine default (applies when no -profile is given) -> local / Docker.
// --network host: the surrogate server and MCMC are separate containers that talk
//     over localhost (UM-Bridge). Apptainer shares the host network already.
docker.enabled    = true
docker.runOptions = '--network host'

profiles {
    // Local workstation: Docker. Mirrors the default above; kept explicit so
    // `-profile local` is a valid, self-documenting choice.
    local {
        docker.enabled    = true
        apptainer.enabled = false
    }

    // Shared cluster node: Apptainer instead of Docker (pulls the GHCR images via
    // docker://). Process execution stays on the local executor.
    cluster {
        docker.enabled       = false
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
}
